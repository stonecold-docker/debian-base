#!/bin/sh

set -e

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Installing required packages"
PKG_LIB=""
PKG_DEV="debootstrap perl bash git grep util-linux e2fsprogs"
docker-install -r -u ${PKG_LIB} ${PKG_DEV}
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Downloading bootstrap"
mkdir -p /build
cd /build
wget --no-check-certificate -q https://bitbucket.org/forumi0721/docker-dist-files/raw/master/imagex.sh
chmod +x imagex.sh
git clone https://forumi0721@bitbucket.org/forumi0721/docker-dist-extras.git extras --depth=1
if [ "$(uname -m)" = "x86_64" -a "${BUILD_TAG}" = "aarch64" ]; then
	cp extras/qemu-aarch64-static /usr/bin
	chmod +x /usr/bin/qemu-aarch64-static
elif [ "$(uname -m)" = "x86_64" -a "${BUILD_TAG}" = "armv7" ]; then
	cp extras/qemu-arm-static /usr/bin
	chmod +x /usr/bin/qemu-arm-static
fi
cd /
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Executing bootstrap"
cd /build
if [ "${TARGET_ARCH}" = "x64stable" ]; then
	./imagex.sh -d debian -a ${BUILD_TAG:-x64} -e stable -q
else
	./imagex.sh -d debian -a ${BUILD_TAG:-x64} -q
fi
cd /
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"
echo

echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> Moving output"
cd /
mv /build/dist/dist-* /output
rm -rf /build
echo "[$(TZ="GMT-9" date '+%Y-%m-%d %H:%M:%S')] ==> OK"

